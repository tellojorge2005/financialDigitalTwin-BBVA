	partition Mensual = m
		mode: import
		source =
				let
				    BaseUrl = "https://financial-digital-twin-bbva-022950218031-us-east-2-an.s3.us-east-2.amazonaws.com/",
				    // Cambia solo este Prefijo para cada tabla Gold que quieras cargar:
				    Prefijo = "data/gold/customer_monthly_summary.parquet/",
				
				    // 1. Listar el contenido actual de la carpeta en S3
				    Documento = Xml.Tables(
				        Web.Contents(
				            BaseUrl,
				            [
				                Query = [
				                    #"list-type" = "2",
				                    prefix = Prefijo
				                ]
				            ]
				        )
				    ),
				    Raiz = Documento{0},
				    Archivos = Record.FieldOrDefault(Raiz, "Contents", #table({"Key"}, {})),
				
				    // 2. Filtrar solo los archivos .parquet (ignora _SUCCESS y carpetas)
				    SoloParquet = Table.SelectRows(
				        Archivos,
				        each [Key] <> null and Text.EndsWith(Text.Lower(Text.From([Key])), ".parquet")
				    ),
				
				    // 3. Descargar en memoria cada part-*.parquet y convertirlo en tabla
				    LeerParquet = (Clave as text) as table =>
				        Parquet.Document(
				            Binary.Buffer(
				                Web.Contents(BaseUrl, [RelativePath = Clave])
				            )
				        ),
				
				    Tablas = List.Transform(
				        SoloParquet[Key],
				        each LeerParquet(Text.From(_))
				    ),
				
				    Resultado = Table.Combine(Tablas)
				in
				    Resultado

	annotation PBI_ResultType = Table

