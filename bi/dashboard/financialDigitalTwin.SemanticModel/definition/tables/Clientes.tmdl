table Clientes
	lineageTag: d074c8bf-c8d5-4789-8c55-35f9a6cc9e86

	measure 'Ingreso Promedio 3M' = AVERAGE(Clientes[average_income_3m])
		lineageTag: 3d337778-babe-4cd7-bac9-ce5a221e9556

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Desviacion Estandar Ingreso 3M' = AVERAGE(Clientes[income_std_3])
		lineageTag: 4e819cb9-a723-4278-8723-6a9774c193d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ratio Ahorro 3M' = AVERAGE(Clientes[savings_rate_3m])
		lineageTag: 3817d89f-c04e-4c14-89b5-febbe53ce907

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ratio Deuda Ingreso 3M' = AVERAGE(clientes[debt_payment_ratio_3m])
		lineageTag: 1ce3e5de-39fa-4dde-aada-ecad0bede990

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ratio Gasto Ingreso 3M' =
			
			DIVIDE(
			    SUM(clientes[expenses_3m]),
			    SUM(clientes[income_3m]),
			    0
			)
		lineageTag: 5d113703-7a03-4954-af85-f5c296d057c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variacion Ingreso 3M %' =
			
			DIVIDE(
			    AVERAGE(clientes[monthly_income]) - AVERAGE(clientes[average_income_3m]),
			    AVERAGE(clientes[average_income_3m]),
			    0
			)
		lineageTag: 6e443b90-71e7-4516-a601-0ff7374750d8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ticket Promedio' = AVERAGE(clientes[average_transaction])
		lineageTag: bb324a09-2102-4ef0-8e0f-dc5ee11ea7ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

