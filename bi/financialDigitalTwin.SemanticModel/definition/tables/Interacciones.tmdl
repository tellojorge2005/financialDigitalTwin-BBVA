	partition Interacciones = m
		mode: import
		source =
				let
				    BaseUrl = "https://financial-digital-twin-bbva-022950218031-us-east-2-an.s3.us-east-2.amazonaws.com/",
				    Prefijo = "history/assistant_interactions/",
				
				    // Obtener una página del listado de S3.
				    ObtenerPagina = (Token as nullable text) as record =>
				        let
				            Parametros =
				                if Token = null then
				                    [
				                        #"list-type" = "2",
				                        prefix = Prefijo
				                    ]
				                else
				                    [
				                        #"list-type" = "2",
				                        prefix = Prefijo,
				                        #"continuation-token" = Token
				                    ],
				
				            Documento = Xml.Tables(
				                Web.Contents(BaseUrl, [Query = Parametros])
				            ),
				
				            Raiz = Documento{0},
				
				            Archivos = Record.FieldOrDefault(
				                Raiz,
				                "Contents",
				                #table({"Key"}, {})
				            ),
				
				            HayMas = Text.Lower(
				                Text.From(
				                    Record.FieldOrDefault(Raiz, "IsTruncated", "false")
				                )
				            ) = "true",
				
				            Siguiente =
				                if HayMas then
				                    Text.From(Raiz[NextContinuationToken])
				                else
				                    null
				        in
				            [
				                Archivos = Archivos,
				                Siguiente = Siguiente
				            ],
				
				    // Recorrer también las páginas futuras si el listado supera 1,000 objetos.
				    Paginas = List.Generate(
				        () => [Pagina = ObtenerPagina(null)],
				        each [Pagina] <> null,
				        each [
				            Pagina =
				                if [Pagina][Siguiente] = null then
				                    null
				                else
				                    ObtenerPagina([Pagina][Siguiente])
				        ],
				        each [Pagina][Archivos]
				    ),
				
				    Listado = Table.Combine(Paginas),
				
				    // Ignorar el objeto vacío de la carpeta y conservar solo CSV.
				    SoloCSV = Table.SelectRows(
				        Listado,
				        each
				            [Key] <> null
				            and Text.EndsWith(
				                Text.Lower(Text.From([Key])),
				                ".csv"
				            )
				    ),
				
				    LeerCSV = (Clave as text) as table =>
				        let
				            Archivo = Web.Contents(
				                BaseUrl,
				                [RelativePath = Clave]
				            ),
				
				            Datos = Csv.Document(
				                Archivo,
				                [
				                    Delimiter = ",",
				                    Encoding = 65001,
				                    QuoteStyle = QuoteStyle.Csv
				                ]
				            ),
				
				            Encabezados = Table.PromoteHeaders(
				                Datos,
				                [PromoteAllScalars = true]
				            )
				        in
				            Encabezados,
				
				    Tablas = List.Transform(
				        SoloCSV[Key],
				        each LeerCSV(Text.From(_))
				    ),
				
				    Campos = {
				        "interaccion_id",
				        "conversacion_id",
				        "fecha_hora_utc",
				        "fecha_utc",
				        "hora_utc",
				        "duracion_segundos",
				        "http_status",
				        "resultado",
				        "registro_completo",
				        "llamadas_modelo",
				        "errores_modelo",
				        "llamadas_herramientas",
				        "errores_herramientas",
				        "usos_meta",
				        "usos_escenario",
				        "usos_historial",
				        "usos_cancelacion"
				    },
				
				    Combinados =
				        if List.IsEmpty(Tablas) then
				            #table(Campos, {})
				        else
				            Table.Combine(Tablas),
				
				    Columnas = Table.SelectColumns(
				        Combinados,
				        Campos,
				        MissingField.UseNull
				    ),
				
				    VaciosANull = Table.ReplaceValue(
				        Columnas,
				        "",
				        null,
				        Replacer.ReplaceValue,
				        Campos
				    ),
				
				    Tipos = Table.TransformColumnTypes(
				        VaciosANull,
				        {
				            {"interaccion_id", type text},
				            {"conversacion_id", type text},
				            {"fecha_hora_utc", type datetimezone},
				            {"fecha_utc", type date},
				            {"hora_utc", Int64.Type},
				            {"duracion_segundos", type number},
				            {"http_status", Int64.Type},
				            {"resultado", type text},
				            {"registro_completo", Int64.Type},
				            {"llamadas_modelo", Int64.Type},
				            {"errores_modelo", Int64.Type},
				            {"llamadas_herramientas", Int64.Type},
				            {"errores_herramientas", Int64.Type},
				            {"usos_meta", Int64.Type},
				            {"usos_escenario", Int64.Type},
				            {"usos_historial", Int64.Type},
				            {"usos_cancelacion", Int64.Type}
				        },
				        "en-US"
				    ),
				
				    SinDuplicados = Table.Distinct(
				        Tipos,
				        {"interaccion_id"}
				    ),
				
				    // Mostrar el horario de Ciudad de México: UTC-6.
				    FechaHoraLocal = Table.AddColumn(
				        SinDuplicados,
				        "fecha_hora_local",
				        each DateTimeZone.RemoveZone(
				            DateTimeZone.SwitchZone([fecha_hora_utc], -6)
				        ),
				        type datetime
				    ),
				
				    FechaLocal = Table.AddColumn(
				        FechaHoraLocal,
				        "fecha_local",
				        each Date.From([fecha_hora_local]),
				        type date
				    ),
				
				    HoraLocal = Table.AddColumn(
				        FechaLocal,
				        "hora_local",
				        each Time.Hour(Time.From([fecha_hora_local])),
				        Int64.Type
				    )
				in
				    HoraLocal

	annotation PBI_ResultType = Table

