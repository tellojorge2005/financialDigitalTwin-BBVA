table Interacciones
	lineageTag: 1e5d7594-ef60-4639-ae73-87be3a23836a

	measure 'Total interacciones' =
			
			COUNTROWS(Interacciones)
		formatString: 0
		lineageTag: 19b78120-2da6-4aae-8624-d7c61b41743d

	measure Conversaciones =
			
			COUNTROWS(
			    FILTER(
			        VALUES(Interacciones[conversacion_id]),
			        NOT ISBLANK(Interacciones[conversacion_id])
			    )
			)
		formatString: 0
		lineageTag: b3347fb5-93d1-4c63-bf76-8ddad0a6e746

	measure 'Tiempo promedio (s)' =
			
			CALCULATE(
			    AVERAGE(Interacciones[duracion_segundos]),
			    Interacciones[registro_completo] = 1
			)
		lineageTag: a79c5b16-d25f-49b9-accb-f11f7e88dead

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Errores HTTP' =
			
			COALESCE(
			    CALCULATE(
			        COUNTROWS(Interacciones),
			        Interacciones[http_status] >= 400
			    ),
			    0
			)
		formatString: 0
		lineageTag: 62a0a9f6-11c3-4361-98a4-7312a9f31bad

	measure 'Porcentaje errores' =
			
			DIVIDE(
			    [Errores HTTP],
			    COUNT(Interacciones[http_status]),
			    0
			)
		lineageTag: e603bfef-5315-4a02-94d4-69abf9dfb8bf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

